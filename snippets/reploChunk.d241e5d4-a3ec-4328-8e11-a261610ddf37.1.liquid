64f-b419d2d35570?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/583f529e-d2a3-4a22-b8f1-9e41d1dd4388/212fae45-8194-4fe3-b64f-b419d2d35570" alt="Milk being poured into a glass with cacao chai latte container nearby." class="r-8u6sbq" loading="eager"/></picture><div data-rid="3fa4362a-dd8e-4262-8bb1-62c71a82a01e" class="r-9r3sah alchemy-rte"><span style="width:100%"><p>Disfrutá de tus honguitos en una bebida deliciosa.</p></span></div></div></div></div><button data-rid="855a2fc3-e520-4095-8ec3-e4e615ff0d71" tabindex="0" class="text r-8an0k alchemy-rte"><div data-rid="c1157c3a-3bb0-4c12-9d11-c044098d9ece" class="r-1h8k1vq alchemy-rte"><span style="width:100%"><p>Probar ahora</p></span></div></button></div></div><div data-rid="885f7401-6e48-4f42-8fca-5e014f5759ef" data-alchemy-url-hashmark="faq" tabindex="-1" id="faq" data-alchemy-url-hashmark-ignore="true" class="r-6qp5lo"><div data-rid="7dbe1a9c-f9ef-4e72-a8c2-d79d7da75bc9" class="r-mbucbf"><div data-rid="0e2a31fb-cd26-49d5-8159-e18266ea48e7" class="r-1d6jwik"><div data-rid="631c5b42-23f2-49e1-83be-480090b9afdb" class="r-10c6l5j alchemy-rte"><span style="width:100%"><h2>Preguntas Frecuentes</h2></span></div></div><div data-rid="d58ddf6f-c8ef-47a9-aebe-d995c51d0cb1" class="r-187k726"><div data-rid="fb4f44d9-33f1-4428-81e6-28130fe1a308" class="r-clb1i9" data-orientation="vertical"><div data-rid="b715d76b-c92b-4113-a3d6-a5e62de9e29b" class="r-1yxgsa7" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="4b6e7b19-3113-4b35-b95f-bb04b42094ae" aria-expanded="false" aria-controls="replo-:R3m32:" tabindex="0" role="button" class="r-1ucv29o"><div data-rid="055530f4-b9ab-43ca-8ce4-52f95477c43f" class="r-1ccywo7 alchemy-rte"><span style="width:100%"><h3>¿Cómo preparo mi bebida Fungalia?</h3></span></div><div data-rid="f59cb3f0-3538-4781-9f5a-2ac6d8bb8f20" class="r-93x2k5" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1l08soq" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:R3m32:"><div data-rid="10805d00-c90a-4b6d-9014-2ae6392604df" class="r-15ytcbs"><div data-rid="af755ba3-bfba-4f2b-bf2a-02a64525c43f" class="r-p6ntwo alchemy-rte"><span style="width:100%"><p>Mezclá 1 cucharada (8g) con 150ml de agua caliente o leche vegetal. Remové bien. Podés disfrutarlo caliente o frío.</p></span></div></div></div></div><div data-rid="313a7874-76c8-498a-8bac-0af243ce9629" class="r-t2npmi" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="1d525138-1e1b-470e-a936-122e3f49e050" aria-expanded="false" aria-controls="replo-:R5m32:" tabindex="0" role="button" class="r-8cm20x"><div data-rid="60baaa4f-1794-4836-96dc-afde64f9df62" class="r-3tufro alchemy-rte"><span style="width:100%"><h3>¿Cuánto tardan en sentirse los efectos?</h3></span></div><div data-rid="d45f9295-573e-4401-8323-55dd95599baa" class="r-czbuh1" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-j5r49s" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:R5m32:"><div data-rid="eadbf47d-f53a-45c3-85f6-48e917bbc9e0" class="r-1g18s36"><div data-rid="9f7bb226-08fc-4efb-b2aa-b5b37fd05d1e" class="r-bdqsnj alchemy-rte"><span style="width:100%"><p>Algunos notan mejoras desde la primera semana. Los beneficios más profundos (menos estrés, mejor foco, mejor sueño) aparecen entre las 2-4 semanas de uso constante.</p></span></div></div></div></div><div data-rid="160a760e-9f3b-4b30-b5b1-04cf8b46a14b" class="r-159ctsh" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="55c1340b-e471-4b59-a6c9-26a5f4e471a1" aria-expanded="false" aria-controls="replo-:R7m32:" tabindex="0" role="button" class="r-109jzrc"><div data-rid="14797184-1375-46fa-82d2-165375592d6a" class="r-fx5erk alchemy-rte"><span style="width:100%"><h3>¿Puedo tomar Fungalia todos los días?</h3></span></div><div data-rid="6cdd9742-6816-4847-b13d-9f2183874907" class="r-1qt1t83" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-cv5c5d" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:R7m32:"><div data-rid="2e26e740-431a-4993-8fbc-77991bd371d4" class="r-16x2sc6"><div data-rid="c18d146a-290e-4b02-962b-9155629a4ff0" class="r-kjg28h alchemy-rte"><span style="width:100%"><p>Sí. sus efectos se potencian con el consumo regular y constante. Igual te recomendamos no tomar más de dos al día...</p></span></div></div></div></div><div data-rid="a3655292-c9ba-4901-b6c8-cf1ed16b7ce3" class="r-op3oji" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="be138bda-6453-4bcc-b5e1-7606d1a049c1" aria-expanded="false" aria-controls="replo-:R9m32:" tabindex="0" role="button" class="r-iuipbm"><div data-rid="2ac02bdc-1fe3-4869-bb99-0c3c766901e7" class="r-29pudm alchemy-rte"><span style="width:100%"><h3>¿Los productos contienen azúcar?</h3></span></div><div data-rid="4ac62643-3dd5-430d-b19d-20b7d80857e0" class="r-p7v5cu" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1sxutla" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:R9m32:"><div data-rid="acf7594e-6eb0-47ff-b1b1-d95fb34f3007" class="r-4c49c"><div data-rid="9d8ee1cc-8fa1-4eb4-a431-2e4330e806ca" class="r-7ydnyl alchemy-rte"><span style="width:100%"><p>No. Tienen dulzor natural gracias a la lúcuma, con bajo índice glucémico y sin azúcares añadidos.</p></span></div></div></div></div><div data-rid="e8878386-99ef-4539-8921-9fbaa4382b0e" class="r-11yddeo" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="a34d5fe8-818c-4cd5-8169-7a954ba36d06" aria-expanded="false" aria-controls="replo-:Rbm32:" tabindex="0" role="button" class="r-slwb2l"><div data-rid="88e52b31-3571-4027-ad82-4927e1863a43" class="r-jln4im alchemy-rte"><span style="width:100%"><p>¿Cuál es el mejor momento para cada blend?</p></span></div><div data-rid="890eb1c0-b672-45c2-b149-9f849eadd06c" class="r-icada9" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1e3ipmk" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rbm32:"><div data-rid="95921ef1-5c09-4047-bde5-170ee407c66a" class="r-1ctzxxw"><div data-rid="7a965d21-6f3b-43da-8d67-4fb683f719b7" class="r-fps3gn alchemy-rte"><span style="width:100%"><ul><li><p><strong>Golden Milk</strong> → Ideal para la <strong>mañana</strong> o la <strong>media tarde</strong>. Te da energía estable y claridad mental sin los picos del café.</p></li><li><p><strong>Matcha Super Latte</strong> → Perfecto para cuando necesitás <strong>foco y rendimiento</strong>, por la mañana o antes de estudiar/trabajar.</p></li><li><p><strong>Cacao Chai</strong> → Va muy bien en la <strong>tarde</strong>, como un reemplazo al segundo café, aportando energía sostenida y buen ánimo.</p></li><li><p><strong>Rooibos Floral Dream</strong> → Diseñado para la <strong>noche</strong> o momentos de relax, ayuda a bajar revoluciones y a descansar mejor.</p></li></ul></span></div></div></div></div><div data-rid="15a32e4c-d6d6-4cd4-b530-0ac6248a60d3" class="r-152l4be" data-replo-collapsible="true" data-state="closed" data-orientation="vertical"><div data-rid="7a7c3601-cf4c-486e-af27-0190862f779c" aria-expanded="false" aria-controls="replo-:Rdm32:" tabindex="0" role="button" class="r-172px9o"><div data-rid="fbf8f9c8-840e-49b4-982c-493b82efef4f" class="r-1ba71aw alchemy-rte"><span style="width:100%"><h3>¿Puedo combinar blends y otros suplementos en el mismo día?</h3></span></div><div data-rid="a31f568d-c1de-4471-bc51-02cda420aa83" class="r-1q2o9c1" aria-hidden="true"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" role="img" aria-label="Collapse/Expand" style="width:var(--rsw, 100%);height:auto;max-height:100%" class="r-1qnq7xa" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708"></path></svg></div></div><div class="replo-animated" hidden="" id="replo-:Rdm32:"><div data-rid="3939f5d1-9bc6-4e70-bdb9-2ab36205d298" 